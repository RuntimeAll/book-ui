            "header": true
           },
           {
            "imgs": [
             "https://ai-book.oss-cn-hangzhou.aliyuncs.com/kg/science/zj2024/g7s/1.2.1/image11.jpeg",
             "https://ai-book.oss-cn-hangzhou.aliyuncs.com/kg/science/zj2024/g7s/1.2.1/image12.png"
            ],
            "spans": [
             {
              "t": "把某些难以用常规仪器直接测量的微小量累积起来，将小量变成较大量测量"
