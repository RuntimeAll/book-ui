            ],
            "spans": [
             {
              "t": "用已知周长的滚轮在待测的较长的直线或曲线（如操场跑道、某段道路等）上滚动，记下滚动的圈数，用滚轮的周长乘圈数得出被测长度"
             }
            ],
            "header": false
           }
          ],
          [
           {
            "imgs": [],
            "spans": [
             {
              "t": "累积法"
